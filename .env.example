# Aegir Configuration

# Environment
MCP_ENV=development

# Server Configuration
PORT=8443
HOST=localhost
READ_TIMEOUT=10
WRITE_TIMEOUT=10

# TLS Configuration
TLS_ENABLED=true
TLS_CERT_FILE=certs/cert.pem
TLS_KEY_FILE=certs/key.pem
TLS_MIN_VERSION=1.3

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ISSUER=aegir
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# OAuth Configuration (optional)
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=

# API Keys
API_KEYS_ENABLED=true

# Multi-Factor Authentication
MFA_REQUIRED=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/aegir.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30
LOG_COMPRESS=true
LOG_HMAC_KEY=your-super-secret-hmac-key-min-32-chars
LOG_INTEGRITY_CHECKS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100
RATE_LIMIT_BURST=20
RATE_LIMIT_CLEANUP=300

# Content Sanitization
SANITIZATION_ENABLED=true
XSS_PREVENTION=true
SQL_INJECTION_PREVENTION=true
HOMOGLYPH_FILTER=true
FORMULA_DETECTION=true

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY_SIZE=256
KEY_ROTATION_DAYS=90
HARDWARE_HSM=false
CLOUD_KMS=

# Secret Detection
SECRET_DETECTION_ENABLED=true
DETECT_API_KEYS=true
DETECT_SSH_KEYS=true
DETECT_CERTIFICATES=true
DETECT_PASSWORDS=true

# Command Injection Prevention
COMMAND_INJECTION_PREVENTION=true
COMMAND_INJECTION_STRICT=true

# HIPAA Compliance
HIPAA_ENABLED=false
PHI_DETECTION=false
HIPAA_ENCRYPTION=false
HIPAA_AUDIT=false

# PCI DSS Compliance
PCI_ENABLED=false
CARD_DETECTION=false
TOKENIZE_CARDS=false
PCI_ENCRYPT_STORAGE=false

# GDPR Compliance
GDPR_ENABLED=false
PII_DETECTION=false
RIGHT_TO_ERASURE=false
DATA_PORTABILITY=false
CONSENT_TRACKING=false
GDPR_REGION=EU

# SOC 2 Compliance
SOC2_ENABLED=false
SOC2_TYPE2=false

# Upstream Service Configuration (NEW - Proxy/Firewall Functionality)
UPSTREAM_SERVICE_NAME=example-mcp-service
UPSTREAM_SERVICE_URL=http://localhost:8080
UPSTREAM_TRANSPORT=http
UPSTREAM_ENABLED=true
UPSTREAM_TIMEOUT=30
UPSTREAM_WEIGHT=100
UPSTREAM_PRIORITY=1

# Upstream TLS Configuration
UPSTREAM_TLS_ENABLED=false
UPSTREAM_TLS_SKIP_VERIFY=false
UPSTREAM_TLS_CLIENT_CERT_FILE=
UPSTREAM_TLS_CLIENT_KEY_FILE=
UPSTREAM_TLS_CA_CERT_FILE=
UPSTREAM_TLS_SERVER_NAME=

# Service Discovery Configuration
DISCOVERY_ENABLED=false
DISCOVERY_PROVIDER=static
DISCOVERY_ENDPOINT=
DISCOVERY_NAMESPACE=
DISCOVERY_INTERVAL=30

# Load Balancing Configuration
LOAD_BALANCING_STRATEGY=round_robin
LOAD_BALANCING_STICKY_KEY=
LOAD_BALANCING_HASH_KEY=

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_HEALTHY_THRESHOLD=2
HEALTH_CHECK_UNHEALTHY_THRESHOLD=3
HEALTH_CHECK_PATH=/health

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# Retry Configuration
RETRY_ENABLED=true
RETRY_MAX_RETRIES=3
RETRY_BACKOFF_MS=100
RETRY_MAX_BACKOFF_MS=1000

# Prompt Injection Protection (NEW)
PROMPT_INJECTION_PREVENTION=true