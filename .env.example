# Aegir environment variables — LIVE list (F9, bundle 6)
#
# Configuration precedence: --config file > env vars > defaults.
# The config file is the PRIMARY surface. Because viper's AutomaticEnv does
# not influence Unmarshal (viper#584), only the env vars listed below are
# read by the server; every other name (the old unprefixed set: PORT, HOST,
# TLS_ENABLED, JWT_SECRET, UPSTREAM_SERVICE_URL, RATE_LIMIT_*, ...) is NOT
# read and has been removed from this file.
#
# Load the file with: ./bin/aegir --config /path/to/aegir.yaml -env .env
# (the -env flag loads the file into the process environment via godotenv).

# --- environment name (development | staging | production) ---
MCP_ENV=development

# --- LLM judge (M009) — the only subsystem with full env override ---
MCP_JUDGE_ENABLED=false
MCP_JUDGE_PROVIDER=ollama
MCP_JUDGE_BASE_URL=http://localhost:11434
MCP_JUDGE_MODEL=llama3
MCP_JUDGE_API_KEY=
MCP_JUDGE_TIMEOUT_MS=5000

# --- feature gates (init-time switches) ---
MCP_SESSION_ANALYSIS_ENABLED=true
MCP_SECURITY_ANOMALY_DETECTION_ENABLED=false
MCP_SECURITY_RATE_LIMIT_ENABLED=true

# --- dev opt-ins (not configuration; the secret guard reads these directly) ---
# Allow the dev placeholder JWT secret in non-production (loud startup warning).
AEGIR_ALLOW_INSECURE_JWT_SECRET=
# Pre-set the generated admin password (otherwise one is generated and logged).
AEGIR_ADMIN_PASSWORD=

# Everything else — server port/TLS, auth, logging, security, compliance,
# upstream services — is configured in the --config file (see
# config/aegir.yaml for the full annotated schema).
