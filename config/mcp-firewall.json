{
  "_comment": "MCP Firewall Configuration - JSON Example",
  "_description": "This configuration shows production-ready settings with enhanced security",

  "environment": "production",

  "server": {
    "port": 8443,
    "host": "0.0.0.0",
    "read_timeout": 30,
    "write_timeout": 30,
    "tls": {
      "enabled": true,
      "cert_file": "/etc/ssl/certs/mcp-firewall.crt",
      "key_file": "/etc/ssl/private/mcp-firewall.key",
      "min_tls": "1.3"
    }
  },

  "auth": {
    "jwt": {
      "secret": "REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS",
      "issuer": "mcp-firewall-prod",
      "expiration_time": 1800,
      "refresh_expiration": 43200
    },
    "oauth": {
      "enabled": true,
      "client_id": "your-oauth-client-id",
      "client_secret": "your-oauth-client-secret",
      "redirect_url": "https://your-domain.com/auth/oauth/callback",
      "auth_url": "https://provider.com/oauth/authorize",
      "token_url": "https://provider.com/oauth/token"
    },
    "api_keys": {
      "enabled": true
    },
    "mfa": {
      "required": true,
      "providers": ["totp", "sms", "email"]
    }
  },

  "logging": {
    "level": "warn",
    "format": "json",
    "file": "/var/log/mcp-firewall/mcp-firewall.log",
    "max_size": 500,
    "max_backups": 30,
    "max_age": 90,
    "compress": true,
    "hmac_key": "REPLACE_WITH_SECURE_HMAC_KEY_MIN_32_CHARS",
    "integrity_checks": true
  },

  "security": {
    "rate_limit": {
      "enabled": true,
      "requests_per_min": 1000,
      "burst_size": 100,
      "cleanup_interval": 300
    },
    "sanitization": {
      "enabled": true,
      "xss_prevention": true,
      "sql_injection": true,
      "homoglyph_filter": true,
      "formula_detection": true,
      "prompt_injection": true
    },
    "encryption": {
      "algorithm": "AES-256-GCM",
      "key_size": 256,
      "key_rotation": 30,
      "hardware_hsm": true,
      "cloud_kms": "aws-kms"
    },
    "secret_detection": {
      "enabled": true,
      "api_keys": true,
      "ssh_keys": true,
      "certificates": true,
      "passwords": true,
      "custom_patterns": [
        "(?i)password\\s*[:=]\\s*['\"]?[a-zA-Z0-9!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{8,}",
        "(?i)secret\\s*[:=]\\s*['\"]?[a-zA-Z0-9!@#$%^&*()_+\\-=\\[\\]{}|;:,.<>?]{16,}"
      ]
    },
    "command_injection": {
      "enabled": true,
      "strict_mode": true,
      "block_list": [
        "eval\\s*\\(",
        "exec\\s*\\(",
        "system\\s*\\(",
        "shell_exec\\s*\\(",
        "passthru\\s*\\("
      ],
      "allow_list": []
    }
  },

  "compliance": {
    "hipaa": {
      "enabled": false,
      "phi_detection": false,
      "encryption": false,
      "audit_trail": false
    },
    "pci": {
      "enabled": true,
      "card_detection": true,
      "tokenize_cards": true,
      "encrypt_storage": true
    },
    "gdpr": {
      "enabled": true,
      "pii_detection": true,
      "right_to_erasure": true,
      "data_portability": true,
      "consent_tracking": true,
      "region": "EU"
    },
    "soc2": {
      "enabled": true,
      "type2": true
    }
  },

  "upstream": {
    "services": [
      {
        "name": "production-mcp-service",
        "url": "https://mcp-service.internal.company.com",
        "transport": "http",
        "weight": 100,
        "priority": 1,
        "enabled": true,
        "timeout": 30,
        "tags": ["production", "primary", "us-east-1"],
        "metadata": {
          "datacenter": "us-east-1a",
          "version": "2.1.0",
          "team": "platform",
          "environment": "production"
        },
        "tls": {
          "enabled": true,
          "skip_verify": false,
          "client_cert_file": "/etc/ssl/certs/mcp-client.crt",
          "client_key_file": "/etc/ssl/private/mcp-client.key",
          "ca_cert_file": "/etc/ssl/certs/ca.crt",
          "server_name": "mcp-service.internal.company.com"
        }
      },
      {
        "name": "production-mcp-service-backup",
        "url": "https://mcp-service-backup.internal.company.com",
        "transport": "http",
        "weight": 50,
        "priority": 2,
        "enabled": true,
        "timeout": 30,
        "tags": ["production", "backup", "us-west-2"],
        "metadata": {
          "datacenter": "us-west-2a",
          "version": "2.1.0",
          "team": "platform",
          "environment": "production"
        },
        "tls": {
          "enabled": true,
          "skip_verify": false,
          "client_cert_file": "/etc/ssl/certs/mcp-client.crt",
          "client_key_file": "/etc/ssl/private/mcp-client.key",
          "ca_cert_file": "/etc/ssl/certs/ca.crt",
          "server_name": "mcp-service-backup.internal.company.com"
        }
      }
    ],
    "discovery": {
      "enabled": true,
      "provider": "consul",
      "endpoint": "https://consul.internal.company.com",
      "namespace": "mcp-services",
      "interval": 30
    },
    "load_balancing": {
      "strategy": "weighted",
      "sticky_key": "X-Session-ID",
      "hash_key": "client_id"
    },
    "health_check": {
      "enabled": true,
      "interval": 15,
      "timeout": 5,
      "healthy_threshold": 3,
      "unhealthy_threshold": 2,
      "path": "/health",
      "expected_codes": [200, 204]
    },
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 3,
      "recovery_timeout": 30,
      "half_open_requests": 5
    },
    "retry": {
      "enabled": true,
      "max_retries": 2,
      "backoff_ms": 250,
      "max_backoff_ms": 2000
    }
  }
}